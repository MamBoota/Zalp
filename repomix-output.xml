<file path="create_readme.sh">
#!/bin/bash

# ╔══════════════════════════════════════════════════════╗
# ║     Скрипт создания README.md для проекта Zalp       ║
# ║                    Версия 4.1                        ║
# ╚══════════════════════════════════════════════════════╝

set -e

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}Создание README.md (v4.1)...${NC}"

